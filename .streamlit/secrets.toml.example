# Copy this file to .streamlit/secrets.toml and fill in your real values.
# The app runs fine WITHOUT any of this (local demo mode + offline NLP),
# so only fill in what you've set up so far.

# Google Gemini (AI summaries, quizzes, flashcards, chatbot)
GEMINI_API_KEY = "AIzaSyB5Bbi_rjj8amUXrmOoeGnSmofBtbA_VOs"
GEMINI_MODEL = "gemini-2.0-flash"

# Firebase Authentication
# Found in Firebase Console > Project Settings > General > Web API Key
FIREBASE_WEB_API_KEY = "AIzaSyDdjOzY41N0ijZ1-JtP4BahVsrn-cBea40"

# ── "Sign in with Google" button (Streamlit's native OIDC login) ───────
# This is separate from Firebase Authentication above - it's Streamlit's
# own built-in st.login() system. See SETUP.md for how to get these values
# from Google Cloud Console.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "f3a80bdbec9c7f61b8b2801785bce79860aa3ff79e7208ba49ce2b8e937e1858"
client_id = "922197826982-h54j95i0279gtahictpudp7ku8fc1hgl.apps.googleusercontent.com"
client_secret = "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"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# ── Firebase Firestore (service account for server-side reads/writes) ──
# Firebase Console > Project Settings > Service Accounts > Generate new
# private key. Paste the downloaded JSON's fields below.
[firebase_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "xxxx"
private_key = "-----BEGIN PRIVATE KEY-----\nxxxx\n-----END PRIVATE KEY-----\n"
client_email = "firebase-adminsdk-xxxx@your-project-id.iam.gserviceaccount.com"
client_id = "xxxx"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxx%40your-project-id.iam.gserviceaccount.com"
